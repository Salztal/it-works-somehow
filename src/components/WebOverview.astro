---
import {webLessons,webMissions,webPath,units} from '../lib/web';
import {labs,intents} from '../content/web/labs';
import {href} from '../lib/catalog';
const {section}=Astro.props as {section?:string};
---
{!section&&<><p class="notice">ブラウザからDBまで、通信のどこで何が起きるかを観測して説明する講座です。若手SE向けの5 Unit・15講義・5ミッション・60問。例は全て架空です。</p><h2>何をしたい？ 何が起きている？</h2><ul class="test-intents">{intents.map(i=><li><strong>{i.title}</strong><div><a href={href(webPath(i.lesson))}>仕組みを読む</a><a href={href(`/web/lab/${i.lab}/`)}>操作して試す</a><a href={href(webPath(i.mission))}>証拠から判断する</a></div></li>)}</ul><div class="start-links"><a class="button" href={href(webPath('web-h01'))}>H01から順に学ぶ →</a><a class="button secondary" href={href('/web/diagnosis/')}>Web障害診断センター →</a></div><nav class="test-lab-nav" aria-label="Web教材への入口"><a href={href('/web/lab/')}>操作教材8種類</a><a href={href('/web/comparisons/')}>実務で使う12の比較</a><a href={href('/web/sources/')}>一次資料とモデルの範囲</a></nav><details><summary>操作教材を一覧から選ぶ</summary><ul>{labs.map(([key,label])=><li><a href={href(`/web/lab/${key}/`)}>{label}</a></li>)}</ul></details></>}
{units.map((u,i)=>(!section||section===`unit-${i+1}`)&&<section><h2 class="list-heading">Unit {i+1}：{u}</h2><ol class="git-course-list">{webLessons.filter(l=>l.unit===i+1).map(l=><li><a href={href(webPath(l.id))} data-progress-key={`web:${l.id}`}><span>{l.number}</span><strong>{l.title}</strong><small>{l.description}</small><span class="done-indicator" aria-label="完了"></span></a></li>)}</ol></section>)}
{(!section||section==='exercises')&&<section><h2 class="list-heading">実践ミッション</h2><ol class="git-course-list">{webMissions.map(m=><li><a href={href(webPath(m.id))} data-progress-key={`web:${m.id}`}><span>{m.number}</span><strong>{m.title}</strong><small>{m.description}</small><span class="done-indicator" aria-label="完了"></span></a></li>)}</ol></section>}

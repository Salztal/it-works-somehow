---
import {webLessons,webMissions,webPath,sources,webConnections} from '../lib/web';
import {entries,href,areaLabel} from '../lib/catalog';
import TestQuestions from './TestQuestions.astro';
import WebLab from './WebLab.astro';
const {id}=Astro.props as {id:string};
const l=webLessons.find(x=>x.id===id),m=webMissions.find(x=>x.id===id),item=(l||m)!;
const links=Object.entries(webConnections).filter(([,ids])=>ids.includes(id)).map(([key])=>entries.find(e=>e.id===key)).filter(e=>!!e);
---
{l?<><section class="learning-goals"><h2 id="situation">観測した事象</h2><p>{l.situation}</p></section><h2 id="think">まず考える</h2><p>{l.think}</p><label for="web-think">予想とその根拠</label><textarea id="web-think" rows="3" data-recall={`${id}:think`}></textarea><h2 id="mechanism">仕組みと境界</h2>{l.explanation.map(p=><p>{p}</p>)}<h2 id="example">具体例を読む</h2><div class="table-scroll" role="region" aria-label="HTTPの具体例" tabindex="0"><table><thead><tr>{l.example.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{l.example.rows.map(row=><tr>{row.map((v,i)=>i===0?<th scope="row">{v}</th>:<td>{v}</td>)}</tr>)}</tbody></table></div><h2 id="practice">操作して観測する</h2><p>{l.practice}</p><WebLab kind={l.lab}/><details><summary>操作後の確認</summary><p>{l.observation}</p></details><h2 id="pitfalls">判断の注意点</h2><ul>{l.pitfalls.map(p=><li>{p}</li>)}</ul><TestQuestions id={id} questions={l.quiz}/></>:<><h2 id="situation">背景と前提</h2><p>{m!.background}</p><p class="notice">{m!.assumptions}</p><h2 id="evidence">証拠</h2><ul>{m!.evidence.map(p=><li>{p}</li>)}</ul><TestQuestions id={id} questions={m!.quiz}/><h2 id="assignment">調査記録を作る</h2><p>{m!.assignment}</p><label for="web-investigation">事実・仮説・追加検証・修正候補・回帰範囲</label><textarea id="web-investigation" rows="7" data-recall={`${id}:investigation`}></textarea><WebLab kind={m!.lab}/><h2 id="explanation">解説</h2><details><summary>自分の判断と比較する</summary>{m!.explanation.map(p=><p>{p}</p>)}</details><h2 id="unknown">未確認事項と残存リスク</h2><h3>未確認</h3><ul>{m!.unknown.map(p=><li>{p}</li>)}</ul><h3>残存リスク</h3><ul>{m!.risks.map(p=><li>{p}</li>)}</ul></>}
<h2 id="sources">関連教材・出典</h2><ul>{item.related.map(key=>{const other=[...webLessons,...webMissions].find(x=>x.id===key)!;return <li><a href={href(webPath(key))}>{other.number} {other.title}</a></li>;})}{links.map(e=><li><a href={href(e!.path)}>{areaLabel(e!.area)}：{e!.label}</a></li>)}<li><a href={href('/web/diagnosis/')}>Web障害診断センター</a></li><li><a href={href('/web/comparisons/')}>実務で使う12の比較</a></li></ul><p class="source-note">独自執筆の架空事例です。操作はブラウザ内の合成データのみ。仮想時間は実測値ではありません。</p><ol class="references">{item.sources.map(k=>{const r=sources[k];return <li><a href={r.url}>{r.title}</a><br/>{r.publisher} ／ {r.version}<br/>確認日：<time datetime={r.checked}>{r.checked}</time><p>{r.scope}</p></li>;})}</ol><label for="web-note">学習メモ</label><textarea id="web-note" data-note={`web:${id}`} rows="4"></textarea>

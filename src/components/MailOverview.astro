---
import {mailLessons,mailMissions,mailPath,units} from '../lib/mail';
import {intents,labs} from '../content/mail/labs';
import {href} from '../lib/catalog';
const {section}=Astro.props as {section?:string};
---
{!section&&<><p class="notice">新人〜入社3年目程度のITエンジニアへ。「なぜ届くのか、なぜ届かないのか」を説明する講座です。全てブラウザ内の合成データで、実メールサーバー・実DNS・外部サービスに接続しません。実環境で検証した結果ではありません。</p><h2>疑問から読み始める</h2><ul class="test-intents">{intents.map(([title,id])=><li><a href={href(mailPath(id))}>{title} →</a></li>)}</ul><div class="start-links"><a class="button" href={href(mailPath('mail-ml01'))}>ML01から学ぶ →</a><a class="button secondary" href={href('/mail/lab/trace/')}>メールを1段ずつ追う →</a></div><h2>学び方</h2><p>Unit 1で送信・閲覧、Unit 2でサーバーとキュー、Unit 3でDNS・認証・TLS、Unit 4で運用、Unit 5で障害調査を学びます。各講義の3問と5ミッションの計60問で、事実・原因候補・未確認事項を整理します。LUNATICは設けていません。</p><nav class="test-lab-nav" aria-label="Mail操作教材と資料"><a href={href('/mail/lab/')}>8種類の操作教材</a><a href={href('/mail/diagnosis/')}>メール配送障害診断センター</a><a href={href('/mail/comparisons/')}>16の比較</a><a href={href('/mail/glossary/')}>用語集</a><a href={href('/mail/sources/')}>一次資料・版・モデルの範囲</a></nav><details><summary>操作教材を選ぶ</summary><ul>{labs.map(([key,title])=><li><a href={href(`/mail/lab/${key}/`)}>{title}</a></li>)}</ul></details></>}
{units.map((title,i)=>(!section||section===`unit-${i+1}`)&&<section><h2 class="list-heading">Unit {i+1}：{title}</h2><ol class="git-course-list">{mailLessons.filter(l=>l.unit===i+1).map(l=><li><a href={href(mailPath(l.id))} data-progress-key={`mail:${l.id}`}><span>{l.number}</span><strong>{l.title}</strong><small>{l.description}</small><span class="done-indicator" aria-label="完了"></span></a></li>)}</ol></section>)}
{(!section||section==='exercises')&&<section><h2 class="list-heading">実践ミッション</h2><ol class="git-course-list">{mailMissions.map(m=><li><a href={href(mailPath(m.id))} data-progress-key={`mail:${m.id}`}><span>{m.number}</span><strong>{m.title}</strong><small>{m.description}</small><span class="done-indicator" aria-label="完了"></span></a></li>)}</ol></section>}

---
import {testLessons,testMissions,testPath,sources} from '../lib/test-design';
import {href} from '../lib/catalog';
import TestQuestions from './TestQuestions.astro';
import TestLab from './TestLab.astro';
const {id}=Astro.props as {id:string};
const l=testLessons.find(x=>x.id===id),m=testMissions.find(x=>x.id===id),item=(l||m)!;
---
{l?<><section class="learning-goals"><h2 id="situation">実務の問題</h2><p>{l.situation}</p></section><h2 id="think">何を確認する？</h2><p>{l.think}</p><label for="td-think">実行前の予想と、その理由</label><textarea id="td-think" rows="3" data-recall={`${id}:think`}></textarea><h2 id="technique">考え方と技法</h2>{l.explanation.map(p=><p>{p}</p>)}<h2 id="example">設計の具体例</h2><div class="table-scroll" role="region" aria-label="テスト設計の具体例" tabindex="0"><table><thead><tr>{l.example.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{l.example.rows.map(row=><tr>{row.map((v,i)=>i===0?<th scope="row">{v}</th>:<td>{v}</td>)}</tr>)}</tbody></table></div><h2 id="practice">操作して試す</h2><p>{l.practice}</p><TestLab kind={l.lab}/><details><summary>試した後に確認すること</summary><p>{l.observation}</p></details><h2 id="omissions">見落としと実務の注意点</h2><ul>{l.pitfalls.map(p=><li>{p}</li>)}</ul><TestQuestions id={id} questions={l.quiz}/></>:<><h2 id="situation">仕様・背景</h2><p>{m!.background}</p><h2 id="scope">現在のテスト範囲</h2><p>{m!.scope}</p><TestQuestions id={id} questions={m!.choices}/><h2 id="assignment">自分で設計する</h2><p>{m!.assignment}</p><label for="td-answer">観点・入力・期待結果・理由・未確認の条件</label><textarea id="td-answer" rows="7" data-recall={`${id}:design`}></textarea><TestLab kind={m!.lab}/><h2 id="model">模範的な考え方</h2><details><summary>自分の設計と比較する</summary><ol>{m!.model.map(p=><li>{p}</li>)}</ol></details><h2 id="risk">検出できる欠陥・残存リスク</h2><ul>{m!.defects.map(p=><li>{p}</li>)}</ul><p>残るリスク：</p><ul>{m!.risks.map(p=><li>{p}</li>)}</ul></>}
<h2 id="sources">関連教材・参考資料</h2><ul>{item.related.map(key=>{const other=[...testLessons,...testMissions].find(x=>x.id===key)!;return <li><a href={href(testPath(key))}>{other.number} {other.title}</a></li>;})}<li><a href={href('/java/lessons/console-dto/')}>Java：DTOと入力から保存まで</a></li><li><a href={href('/git/unit-1/g02/')}>Git：変更の差分を確認する</a></li><li><a href={href('/test-design/templates/')}>観点表・ケース表・不具合報告書</a></li></ul><p class="source-note">独自執筆の例題・仕様・問題です。IPA・JSTQB・ISTQBの公式教材ではありません。シラバス原著の権利はISTQBおよび著者、日本語訳の権利はJSTQBに帰属します。実務上の推奨は本教材の説明であり、規格の要求ではありません。</p><ol class="references">{item.sources.map(k=>{const r=sources[k];return <li><a href={r.url}>{r.title}</a><br/>{r.publisher} ／ {r.version}<br/>確認日：<time datetime={r.checked}>{r.checked}</time><p>{r.scope}</p></li>;})}</ol><label for="td-note">実務での注意・学習メモ</label><textarea id="td-note" data-note={`test-design:${id}`} rows="4"></textarea>

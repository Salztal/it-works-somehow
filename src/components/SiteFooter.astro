  <nav class="footer-courses" aria-label="分野別の教材">{courses.map(c=><a href={href(c.path)}>{c.label}</a>)}</nav>
  <nav class="footer-utilities" aria-label="補助ナビゲーション"><a href={href('/about/')}>このサイトと教材の出典</a><a href={href('/progress/')}>学習記録</a><a href={href('/search/')}>教材検索</a></nav>
</footer>

---
import '../styles/site.css';
import '../styles/web.css';
import '../styles/spring.css';
import '../styles/mail.css';
import '../styles/ui.css';
import GlobalNavigation from '../components/GlobalNavigation.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { entries, href, areaLabel, entryKey } from '../lib/catalog';
interface Props { title: string; description?: string; area?: string; current?: string; wide?: boolean }
const { title, description = '通信・開発・設計・セキュリティを、講義と演習で学ぶ技術学習ノート。', area, current, wide = false } = Astro.props;
const groups = area === 'network'
  ? [['basics', '入門 · 既存01〜05章'], ['unit-a','Unit A · 通信の基本構造'],['unit-b','Unit B · IPと配布'],['unit-c','Unit C · 経路とNAT'],['unit-d','Unit D · TCPとUDP'],['unit-e','Unit E · 名前解決と解析'],['unit-f','Unit F · 設計と障害対応'],['azure', '応用 · Azure構成設計'], ['exercises', '7つのミッション']]
  : area === 'mail' ? [['unit-1','Unit 1 · 電子メール'],['unit-2','Unit 2 · サーバー構造'],['unit-3','Unit 3 · DNS・認証・TLS'],['unit-4','Unit 4 · 運用'],['unit-5','Unit 5 · 障害調査'],['exercises','5つの実践ミッション']]
  : area === 'spring' ? [['unit-1','Unit 1 · 全体像'],['unit-2','Unit 2 · Webの処理'],['unit-3','Unit 3 · JPAとTransaction'],['unit-4','Unit 4 · 業務設計'],['exercises','5つの実践ミッション']]
  : area === 'web' ? [['unit-1','Unit 1 · HTTPの仕組み'],['unit-2','Unit 2 · ブラウザと状態'],['unit-3','Unit 3 · 経路と性能'],['unit-4','Unit 4 · アプリの処理'],['unit-5','Unit 5 · 障害調査'],['exercises','5つの実践ミッション']]
  : area === 'test-design' ? [['unit-1','Unit 1 · 設計の基本'],['unit-2','Unit 2 · ブラックボックス'],['unit-3','Unit 3 · 動作と組み合わせ'],['unit-4','Unit 4 · コードと変更'],['unit-5','Unit 5 · 実務の設計'],['exercises','5つの実践ミッション']]
  : area === 'git' ? [['unit-1','Unit 1 · 基本的な考え方'],['unit-2','Unit 2 · 毎日の開発'],['unit-3','Unit 3 · 履歴の整理'],['unit-4','Unit 4 · 必要な変更だけ'],['unit-5','Unit 5 · 実務と事故対応'],['exercises','5つの実践ミッション']]
  : area === 'security' ? [['basics','BASIC · 基礎'],['advanced','ADVANCED · 設計と調査'],['lunatic','LUNATIC · 技術実験']]
  : [['setup', '準備する'], ['lessons', '講義を読む'], ['exercises', '演習で確かめる']];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | 技術学習ノート</title><meta name="description" content={description} />
    <meta name="theme-color" content="#153e43" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
  </head>
  <body data-base={import.meta.env.BASE_URL} data-current={current}>
    <a class="skip" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={href('/')} aria-label="技術学習ノート ホーム"><span class="brand-mark" aria-hidden="true">技</span><span>技術学習ノート</span></a>
        <GlobalNavigation area={area} />
      </div>
    </header>
    <div class:list={['page-shell', { 'with-sidebar': area, 'has-current': !!current, wide }]}>
      {area && <aside class="sidebar">
        <details class="course-navigation" open={!!current}>
          <summary>{areaLabel(area)}の章目次 <span aria-hidden="true">⌄</span></summary>
          <div class="sidebar-content">
            <a class="course-name" href={href(`/${area}/`)}>{areaLabel(area)}<span>教材一覧 ↗</span></a>
            <nav aria-label={`${areaLabel(area)}の章目次`}>
              {groups.map(([section, label]) => <div class="nav-group"><p>{label}</p>{entries.filter(e => e.area === area && e.section === section).map(e => <a class="chapter-link" href={href(e.path)} aria-current={current === entryKey(e) ? 'page' : undefined} data-progress-key={entryKey(e)}><span class="chapter-number">{e.number}</span><span>{e.label}</span><span class="done-indicator" aria-label="完了"></span></a>)}</div>)}
              {area === 'git' && <div class="nav-group"><p>目的から探す・練習する</p><a class="chapter-link" href={href('/git/rescue/')}>Git救命救急センター →</a><a class="chapter-link" href={href('/git/lab/')}>状態が変わる操作教材 →</a><a class="chapter-link" href={href('/git/comparisons/')}>操作前後の比較 →</a></div>}
              {area === 'test-design' && <div class="nav-group"><p>操作・配布教材</p><a class="chapter-link" href={href('/test-design/lab/')}>考慮漏れ発見ラボ →</a><a class="chapter-link" href={href('/test-design/templates/')}>テンプレート3種 →</a></div>}
              {area === 'web' && <div class="nav-group"><p>観測・診断する</p><a class="chapter-link" href={href('/web/lab/trace/')}>HTTPリクエスト追跡ラボ →</a><a class="chapter-link" href={href('/web/lab/')}>8種類の操作教材 →</a><a class="chapter-link" href={href('/web/diagnosis/')}>Web障害診断センター →</a><a class="chapter-link" href={href('/web/comparisons/')}>実務で使う12の比較 →</a><a class="chapter-link" href={href('/web/sources/')}>一次資料と適用範囲 →</a></div>}
              {area === 'spring' && <div class="nav-group"><p>状態を比較する</p><a class="chapter-link" href={href('/spring/lab/')}>8種類の操作教材 →</a><a class="chapter-link" href={href('/spring/comparisons/')}>14の比較 →</a><a class="chapter-link" href={href('/spring/sources/')}>一次資料とモデル範囲 →</a></div>}
              {area === 'mail' && <div class="nav-group"><p>配送を追跡する</p><a class="chapter-link" href={href('/mail/lab/')}>8種類の操作教材 →</a><a class="chapter-link" href={href('/mail/diagnosis/')}>メール配送障害診断センター →</a><a class="chapter-link" href={href('/mail/comparisons/')}>16の比較 →</a><a class="chapter-link" href={href('/mail/glossary/')}>用語集 →</a><a class="chapter-link" href={href('/mail/sources/')}>一次資料とモデル範囲 →</a></div>}
              {area === 'java' && <a class="download-nav" href={href('/java/downloads/')}>↓ 教材ダウンロード</a>}
            </nav>
            <div class="sidebar-progress"><span>この教材の進捗</span><strong data-course-count={area}>0 / {entries.filter(e => e.area === area).length}</strong><progress data-course-progress={area} value="0" max={entries.filter(e => e.area === area).length}></progress><a href={href('/progress/')}>学習記録を確認する →</a></div>
          </div>
        </details>
      </aside>}
      <main id="main" tabindex="-1"><slot /></main>
    </div>
    <SiteFooter />
    <div id="storage-status" class="storage-status" role="status" hidden></div>
    <script>import '../lib/client'; import '../lib/navigation-client';</script>
  </body>
</html>

---
import '../styles/site.css';
import { entries, href, areaLabel, entryKey } from '../lib/catalog';
interface Props { title: string; description?: string; area?: string; current?: string; wide?: boolean }
const { title, description = 'ネットワークとJavaを、基礎から順に学ぶ技術学習ノート。', area, current, wide = false } = Astro.props;
const groups = area === 'network'
  ? [['basics', '基礎を学ぶ'], ['azure', 'Azure・構成設計'], ['exercises', '演習で確かめる']]
  : [['setup', '準備する'], ['lessons', '講義を読む'], ['exercises', '演習で確かめる']];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | 技術学習ノート</title><meta name="description" content={description} />
    <meta name="theme-color" content="#153e43" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
  </head>
  <body data-base={import.meta.env.BASE_URL} data-current={current}>
    <a class="skip" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={href('/')} aria-label="技術学習ノート ホーム"><span class="brand-mark" aria-hidden="true">技</span><span>技術学習ノート</span></a>
        <nav class="top-nav" aria-label="メインナビゲーション">
          <a href={href('/network/')} aria-current={area === 'network' ? 'true' : undefined}>ネットワーク</a>
          <a href={href('/java/')} aria-current={area === 'java' ? 'true' : undefined}>Java</a>
          <a href={href('/progress/')} aria-current={Astro.url.pathname.endsWith('/progress/') ? 'page' : undefined}>学習記録</a>
        </nav>
        <a class="search-link" aria-label="教材を検索" href={href('/search/')}><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>教材を検索</span><kbd>/</kbd></a>
      </div>
    </header>
    <div class:list={['page-shell', { 'with-sidebar': area, wide }]}>
      {area && <aside class="sidebar">
        <details class="course-navigation" open>
          <summary>章目次 <span aria-hidden="true">⌄</span></summary>
          <div class="sidebar-content">
            <a class="course-name" href={href(`/${area}/`)}>{areaLabel(area)}<span>教材一覧 ↗</span></a>
            <nav aria-label={`${areaLabel(area)}の章目次`}>
              {groups.map(([section, label]) => <div class="nav-group"><p>{label}</p>{entries.filter(e => e.area === area && e.section === section).map(e => <a class="chapter-link" href={href(e.path)} aria-current={current === entryKey(e) ? 'page' : undefined} data-progress-key={entryKey(e)}><span class="chapter-number">{e.number}</span><span>{e.label}</span><span class="done-indicator" aria-label="完了"></span></a>)}</div>)}
              {area === 'java' && <a class="download-nav" href={href('/java/downloads/')}>↓ 教材ダウンロード</a>}
            </nav>
            <div class="sidebar-progress"><span>この教材の進捗</span><strong data-course-count={area}>0 / {entries.filter(e => e.area === area).length}</strong><progress data-course-progress={area} value="0" max={entries.filter(e => e.area === area).length}></progress><a href={href('/progress/')}>学習記録を確認する →</a></div>
          </div>
        </details>
      </aside>}
      <main id="main" tabindex="-1"><slot /></main>
    </div>
    <footer class="site-footer"><div><a href={href('/')}>技術学習ノート</a><span>ネットワーク / Java</span></div><a href={href('/about/')}>このサイトと教材の出典</a></footer>
    <div id="storage-status" class="storage-status" role="status" hidden></div>
    <script>import '../lib/client';</script>
  </body>
</html>

---
import Shell from '../layouts/Shell.astro';
import {href} from '../lib/catalog';
import {courses,helpLinks} from '../lib/navigation';
---
<Shell title="ホーム" wide>
  <header class="home-intro"><p class="eyebrow">学ぶ・確かめる・振り返る</p><h1>ITの仕組みを学び、<br class="home-title-break"/>動かして確かめる。</h1><p>通信・開発・設計・セキュリティから、実務の障害調査まで。<br class="desktop-break"/>講義を読み、操作教材や演習で理解を深める技術学習ノートです。</p></header>
  <section class="home-search" aria-labelledby="home-search-title"><div><h2 id="home-search-title">知りたい言葉から探す</h2><p>講義・操作教材・困りごとを、本文からまとめて検索。</p></div><form action={href('/search/')} role="search"><label class="sr-only" for="home-query">教材を検索</label><input id="home-query" name="q" type="search" placeholder="例：DNS、Transaction、メールが届かない"/><button type="submit">検索</button></form></section>
  <section class="resume-panel" aria-labelledby="resume-title" data-resume-panel hidden><div><span class="small-label">学習のつづき</span><h2 id="resume-title" data-resume-title>前回の教材から再開</h2><p data-resume-detail>学習記録を読み込んでいます。</p></div><a class="button secondary" data-resume-link href={href('/progress/')}>つづきから読む →</a></section>
  <section class="home-purposes" aria-labelledby="quick-title"><div class="section-heading"><h2 id="quick-title">目的から探す</h2><span>いま知りたいことから</span></div><div class="purpose-grid">
    <section class="purpose-card"><span class="small-label">仕組みをつかむ</span><h3>仕組みから学ぶ</h3><p>基礎講義と概念の解説へ。</p><details><summary>講義の分野を選ぶ</summary><ul>{courses.map(c=><li><a href={href(c.path)}>{c.label}<span aria-hidden="true"> →</span></a></li>)}</ul></details></section>
    <section class="purpose-card"><span class="small-label">手を動かす</span><h3>動かして理解する</h3><p>操作教材・シミュレーター・演習へ。</p><details><summary>操作・演習を選ぶ</summary><ul>{courses.filter(c=>c.practice).map(c=><li><a href={href(c.practice!)}>{c.practiceLabel}<span aria-hidden="true"> →</span></a></li>)}</ul><p class="purpose-note">Javaは配布コードを手元の環境で動かす演習です。</p></details></section>
    <section class="purpose-card"><span class="small-label">症状を切り分ける</span><h3>困りごとから調べる</h3><p>症状や状況から、調べる場所を探す。</p><details><summary>症状の入口を選ぶ</summary><ul>{helpLinks.map(c=><li><a href={href(c.path)}>{c.label}<span aria-hidden="true"> →</span></a></li>)}</ul></details></section>
  </div></section>
  <section id="courses" class="home-courses" aria-labelledby="courses-title"><div class="section-heading"><h2 id="courses-title">分野から探す</h2><span>{courses.length}つの学習コース</span></div><div class="course-grid">{courses.map(c=><article class:list={['course-card',`${c.id}-card`]}><h3><a href={href(c.path)}>{c.label}</a></h3><p>{c.summary}</p><div class="course-facts"><span>{c.pages}ページ</span></div><a class="course-cta" href={href(c.path)} aria-label={`${c.label}の教材一覧を見る`}>教材一覧を見る <span aria-hidden="true">→</span></a></article>)}</div></section>
  <aside class="home-note"><p>学習を記録すると、次回は続きから再開できます。記録はこのブラウザに保存されます。</p><a href={href('/progress/')}>学習記録・バックアップ →</a><a href={href('/about/')}>教材と出典について →</a></aside>
</Shell>

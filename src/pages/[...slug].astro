---
import Shell from '../layouts/Shell.astro';
import NetworkContent from '../components/NetworkContent.astro';
import NetworkFoundation from '../components/NetworkFoundation.astro';
import NetworkOverview from '../components/NetworkOverview.astro';
import { networkAdditions, networkToc } from '../lib/network';
import EntryList from '../components/EntryList.astro';
import SecurityContent from '../components/SecurityContent.astro';
import SecurityOverview from '../components/SecurityOverview.astro';
import { security, securityToc } from '../lib/security';
import { entries, sections, network, href, areaLabel, entryKey, type Entry } from '../lib/catalog';
import GitContent from '../components/GitContent.astro';
import GitOverview from '../components/GitOverview.astro';
import { gitToc } from '../lib/git';
import TestContent from '../components/TestContent.astro';
import TestOverview from '../components/TestOverview.astro';
import {testToc} from '../lib/test-design';
import type { MarkdownInstance } from 'astro';
export function getStaticPaths() {
  return [...entries.map(entry => ({ params: { slug: entry.path.slice(1, -1) }, props: { entry } })), ...sections.map(section => ({ params: { slug: section.path.slice(1, -1) }, props: { section } }))];
}
const { entry, section } = Astro.props as { entry?: Entry; section?: typeof sections[number] };
const modules = import.meta.glob<MarkdownInstance<{ title: string }>>('../generated/java/*.md', { eager: true });
const md = entry?.kind === 'java' ? modules[`../generated/java/${entry.id}.md`] : undefined;
const Content = md?.Content;
const title = entry?.label || section!.label;
const area = entry?.area || section!.area;
const list = entries.filter(e => e.area === area);
const idx = entry ? list.indexOf(entry) : -1;
const prev = list[idx - 1], next = list[idx + 1];
const lesson = network.lessons.find(l => l.id === entry?.id);
const foundation = networkAdditions.find(l=>l.id===entry?.id);
const securityLesson = security.find(l => l.id === entry?.id);
const pageTitle = md?.frontmatter.title || title;
const chapterLabel = (area === 'git' || area === 'test-design') ? entry?.number : securityLesson ? `${entry!.number} · ${securityLesson.level}` : entry?.kind === 'mission' || entry?.kind === 'network-mission' ? `ミッション ${entry.number}` : entry && /^\d+$/.test(entry.number) ? `第 ${entry.number} 章` : entry?.id === 'index' ? '学習ガイド' : '補助資料';
const toc = entry?.kind === 'test-design' ? testToc(entry.id) : entry?.kind === 'git' ? gitToc(entry.id) : foundation ? networkToc(foundation) : securityLesson ? securityToc(securityLesson) : md?.getHeadings().filter(h => h.depth === 2) || (entry?.kind === 'mission' ? [['scenario','状況'],['diagram','構成図'],['requirements','要件'],['questions','理由を考える'],['research','Azureを調べる']] : [['goals','学ぶこと'],['everyday','身近な例'],['terms','用語と役割'],['diagram','図で見る'],['azure','Azureでは？'],['quiz','確認問題'],['recall','自分の言葉で説明する'],['research','Azureを調べる']]).map(([slug,text]) => ({ slug,text,depth:2 }));
const filtered = section ? list.filter(e => !('section' in section) || e.section === section.section) : [];
const deepLinks:Record<string,string[]>={network:['n07-models','n22-topology'],'ip-subnet':['n10-subnet','n11-ipv6'],routing:['n13-routing','n14-static-routing'],'dns-port-http':['n16-transport','n19-dns'],'firewall-nsg':['n24-troubleshooting'],challenge:['n22-topology','nm6-path']};
---
<Shell title={title} area={area} current={entry && entryKey(entry)} description={entry?.description || section?.description}>
  <nav class="breadcrumbs" aria-label="パンくずリスト"><a href={href('/')}>ホーム</a><span aria-hidden="true">/</span><a href={href(`/${area}/`)}>{areaLabel(area)}</a>{entry && <><span aria-hidden="true">/</span><span aria-current="page">{entry.label}</span></>}</nav>
  {entry ? <div class="reading-layout"><div class="reading-main">
    <header class="article-header"><p class="eyebrow">{areaLabel(area)} <span>／</span> {chapterLabel}</p><h1>{pageTitle}</h1><p>{lesson?.subtitle || entry.description}</p><div class="article-meta"><span>{entry.kind === 'java' ? 'Java 17 / MySQL / Tomcat 9' : foundation?.unitTitle || securityLesson?.unitTitle || lesson?.title || '構成設計・自己確認'}</span><span data-page-status>未完了</span></div></header>
    {entry.id === 'validation' && <p class="notice">このページは移行元で実施された検証記録です。統合サイトで今回行った検証は、プロジェクトの検証記録を参照してください。</p>}
    {entry.id === 'publishing' && <p class="notice">これは元教材の公開手順です。統合サイトの開発・公開は新プロジェクトのREADMEに従ってください。</p>}
    <article class:list={['prose',{'security-prose':securityLesson || foundation || area === 'git' || area === 'test-design'}]}>{entry.kind === 'test-design' ? <TestContent id={entry.id} /> : entry.kind === 'git' ? <GitContent id={entry.id} /> : foundation ? <NetworkFoundation id={entry.id} /> : securityLesson ? <SecurityContent id={entry.id} /> : Content ? <Content /> : <NetworkContent id={entry.id} kind={entry.kind} />}</article>
    <section class="completion"><div><h2>この章を振り返る</h2><p>{entry.kind === 'mission' ? '自分の考えと参考回答を比べたら、完了を記録しましょう。' : '内容を自分の言葉で説明できたら、完了を記録しましょう。'}</p></div><button class="button" id="mark-complete" type="button" aria-pressed="false">この章を完了にする</button></section>
    <nav class="pager" aria-label="前後の章">{prev ? <a href={href(prev.path)}><small>← 前の章</small><strong>{prev.label}</strong></a> : <span></span>}{next ? <a href={href(next.path)}><small>次の章 →</small><strong>{next.label}</strong></a> : <a href={href(`/${area}/`)}><small>教材の目次へ →</small><strong>{areaLabel(area)}の一覧</strong></a>}</nav>
    {area !== 'security' && area !== 'git' && area !== 'test-design' && <aside class="related"><h2>関連する教材</h2>{area === 'java' ? <><a href={href('/java/downloads/')}>教材ダウンロード →</a><a href={href('/java/lessons/troubleshooting/')}>つまずき集 →</a><a href={href('/java/lessons/glossary/')}>用語集 →</a></> : <><a href={href('/network/exercises/')}>ミッションで確かめる →</a><a href={href('/network/azure/')}>Azure・構成設計 →</a></>}</aside>}
    {area !== 'security' && area !== 'git' && area !== 'test-design' && <div class="related"><h2>Securityとの関連</h2>{(area === 'network' ? ['s07-01','s10-02','s06-01'] : ['s03-01','s05-01','s08-01']).map(id => { const e = entries.find(e => e.id === id)!; return <a href={href(e.path)}>{e.label} →</a>; })}</div>}
    {area === 'network' && deepLinks[entry.id] && <div class="related"><h2>TCP/IPの仕組みを詳しく学ぶ</h2>{deepLinks[entry.id].map(id=>{const e=entries.find(e=>e.area==='network'&&e.id===id)!;return <a href={href(e.path)}>{e.number} {e.label} →</a>;})}</div>}
    {['java','git'].includes(area) && <aside class="related"><h2>テスト設計との関連</h2><a href={href('/test-design/unit-4/td-t11/')}>単体・結合のケースを設計する →</a><a href={href('/test-design/unit-4/td-t12/')}>変更影響と回帰テスト →</a></aside>}
    <p class="source-note">{foundation || area === 'security' || area === 'git' || area === 'test-design' ? '独自執筆。一次資料は本文の参考資料に記録。' : `出典：${area === 'network' ? 'Azure Network Basics（ローカル追加版を含む）' : `Java Study / course/${entry.id}.md`}`} · <a href={href('/about/')}>教材について</a></p>
  </div><aside class="page-toc"><nav aria-label="このページの目次"><p>このページの内容</p>{toc.map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside></div>
  : <div class="course-overview"><header class="overview-header"><p class="eyebrow">{areaLabel(area)}の教材</p><h1>{title}</h1><p>{section!.description}</p></header><div class="course-overview-meta"><span>{filtered.length}ページ</span><span>{area === 'security' ? '基礎から技術実験まで' : '初学者向け'}</span><span>読む → 確かめる → 振り返る</span></div>{area === 'test-design' ? <TestOverview section={'section' in section! ? section!.section : undefined} /> : area === 'git' ? <GitOverview section={'section' in section! ? section!.section : undefined} /> : area === 'security' ? <SecurityOverview section={'section' in section! ? section!.section : undefined} /> : <>{!('section' in section!) && <div class="start-links"><a class="button" href={href(area === 'network' ? entries.find(e=>e.area==='network')!.path : '/java/lessons/index/')}>最初から学ぶ →</a>{area === 'java' && <a class="button secondary" href={href('/java/downloads/')}>教材ダウンロード ↓</a>}</div>}{area === 'network' && !('section' in section!) && <NetworkOverview />}<EntryList items={filtered} /></>}</div>}
</Shell>

---
import Shell from '../../layouts/Shell.astro';
import { href } from '../../lib/catalog';
import manifest from '../../../public/downloads/java/manifest.json';
const names: Record<string,string> = { 'completed.zip':'完成版ソース', 'setup-kit.zip':'SQL・設定・スクリプト', '01-input-start.zip':'第1章 入力と出力', '02-menu-start.zip':'第2章 メニュー', '03-dto-start.zip':'第3章 DTO', '05-register-start.zip':'第5章 DB登録', '06-list-start.zip':'第6章 一覧取得', '07-edit-start.zip':'第7章 更新と削除', '08-web-flow-start.zip':'第8章 Web画面遷移', '09-web-register-start.zip':'第9章 Web登録', '10-web-crud-start.zip':'第10章 WebのCRUD' };
---
<Shell title="教材ダウンロード" area="java"><nav class="breadcrumbs" aria-label="パンくずリスト"><a href={href('/')}>ホーム</a><span>/</span><a href={href('/java/')}>Java</a><span>/</span><span aria-current="page">ダウンロード</span></nav><div class="course-overview"><header class="overview-header"><p class="eyebrow">Javaの演習</p><h1>教材ダウンロード</h1><p>各章の開始コード、完成版、DBの準備に使うSQL。<br />講義の説明と対応した11個のZIPを用意しています。</p></header><p class="notice">同じプロジェクト名のZIPは、別のワークスペースか作業フォルダーへ展開してください。実際の接続設定やJARは含みません。<a href={href('/java/setup/')}>環境構築の手順 →</a></p><div class="downloads">{manifest.map(item => <article class="download-item"><div><span class="file-label">ZIP · {Math.round(item.bytes / 1024)} KB · {item.entries}ファイル</span><h2>{names[item.file]}</h2><p>{item.file}</p><details><summary>SHA-256を確認</summary><code>{item.sha256}</code></details></div><a class="button secondary" href={href('/downloads/java/' + item.file)} download>ダウンロード <span aria-hidden="true">↓</span></a></article>)}</div><p class="source-note">既存のJava Study公開用生成処理から作成。<a href={href('/downloads/java/manifest.json')}>検証用manifest.json</a></p></div></Shell>
